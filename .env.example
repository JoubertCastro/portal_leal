# Server-only. Never prefix secrets with NEXT_PUBLIC_.
APP_ORIGIN=http://127.0.0.1:4174
LEAL_AUTH_URL=
LEAL_AUTH_USUARIO=
LEAL_AUTH_SENHA=
LEAL_SERVER=SRVW-MIS-01
# Cadastro, divida and acordos adapters are server-only; public access stays gated.
# Meta adapter requires an approved authentication template with copy-code button.
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_AUTH_TEMPLATE=
META_AUTH_LANGUAGE=pt_BR
# Real authentication stays unavailable until shared persistence is implemented.
# Analytics: migration/admin credentials NEVER used by the application.
DATABASE_ADMIN_URL=
DATABASE_URL=
DATABASE_CA_FILE=
# Optional certificate DNS name when the authenticated certificate differs from proxy DNS.
DATABASE_TLS_SERVERNAME=
ANALYTICS_ENABLED=false
ANALYTICS_COOKIE_SECRET=
ANALYTICS_SUBJECT_SECRET=
# Configure only with a trusted proxy that overwrites x-leal-geo and x-leal-edge-key.
ANALYTICS_EDGE_SECRET=
