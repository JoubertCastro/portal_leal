{
  "name": "portal-leal",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4174",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "check": "next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts next.config.ts playwright.config.ts eslint.config.mjs",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.database-admin.local --import tsx scripts/migrate.ts",
    "analytics:maintenance": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/analytics-maintenance.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
